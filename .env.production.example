# ==============================================================================
# NahangYab (Walletex) Production Environment Configuration Example
# ==============================================================================
# Copy this file to .env.production on your production VPS and fill in the values:
#   cp .env.production.example .env.production
# ==============================================================================

# Node Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
BUILD_STANDALONE=true
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 0. Canonical Base URL
# ------------------------------------------------------------------------------
# The canonical domain name where your site is hosted (with https://, no trailing slash)
NEXT_PUBLIC_APP_URL=https://nahangyab.com

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Connection string pointing to the docker-compose 'postgres' container service:
# Format: postgresql://<user>:<password>@postgres:5432/<database>
DATABASE_URL=postgresql://postgres:postgres_secure_pass_2026@postgres:5432/walletex

# Variables used by the postgres container init scripts:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
POSTGRES_DB=walletex
POSTGRES_MULTIPLE_DATABASES=walletex,walletex_test

# ------------------------------------------------------------------------------
# 2. Administrator Panel & Security Credentials
# ------------------------------------------------------------------------------
# Strong password for administrator console login (/admin-login):
# Required: Application will abort at startup in production if this is empty.
ADMIN_PASSWORD=Set_A_Strong_Production_Password_Here_2026!

# Cryptographic secret for signing admin session tokens (min 32 characters):
# Required: Application will abort at startup in production if this is empty.
ADMIN_SESSION_SECRET=a_very_secret_cryptographic_key_at_least_32_chars_long_2026

# Secret token for protecting internal background cron jobs (/api/cron/*):
# Used in Authorization: Bearer <CRON_SECRET> header
CRON_SECRET=secure_cron_trigger_token_2026_xyz987

# ------------------------------------------------------------------------------
# 3. Telegram Bot Configuration
# ------------------------------------------------------------------------------
# Telegram Bot API token obtained from @BotFather:
TELEGRAM_BOT_TOKEN=8889631565:AAFN_L1oEVmGTo3FnSrwMkl_ouqW986I8_4

# Telegram Bot username (without @ symbol):
TELEGRAM_BOT_USERNAME=nahangYabbot

# Secret token for authenticating Telegram Webhook calls (x-telegram-bot-api-secret-token):
TELEGRAM_WEBHOOK_SECRET=nahangyab_telegram_webhook_2026_9kR4mX

# ------------------------------------------------------------------------------
# 4. Bale Messenger & Bale Pay Payment Gateway (Iran Local Gateway)
# ------------------------------------------------------------------------------
# Bale Bot token obtained from @BotFather in Bale messenger:
BALE_BOT_TOKEN=2019870496:SGi9O5TcFGSTWVHGO4iDIdSKBwBQh92gkv8

# Bale Pay merchant token for online payment checkout:
BALE_PAYMENT_TOKEN=WALLET-aRecZIJxO5f7hpfe

# Bale Bot username:
BALE_BOT_USERNAME=Nahangyabbot

# Bale Webhook secret header for callback authentication:
BALE_WEBHOOK_SECRET=nahangyab_bale_wh_2026

# ------------------------------------------------------------------------------
# 5. Iranian Payment Gateway (Card-to-Card - CartBeCart)
# ------------------------------------------------------------------------------
# Card-to-Card (CartBeCart) Gateway Credentials:
CARTBECART_API_KEY=
CARTBECART_SIGNATURE_SECRET=

# ------------------------------------------------------------------------------
# 6. External Market Data APIs (Optional)
# ------------------------------------------------------------------------------
# Optional Quiver Quantitative API token for additional Congress PTR live feeds:
# If unset, the app uses official US House Clerk PTR disclosure PDFs directly.
QUIVER_API_TOKEN=

# ------------------------------------------------------------------------------
# 7. Internal Process Configuration (Optional)
# ------------------------------------------------------------------------------
# Process type identifier for database file isolation (web | bot_poller | test):
APP_PROCESS_TYPE=web

# ------------------------------------------------------------------------------
# 8. MelliPayamak SMS Service (OTP Authentication)
# ------------------------------------------------------------------------------
MELLIPAYAMAK_USERNAME=09934625945
MELLIPAYAMAK_API_KEY=your_mellipayamak_api_key_or_password
MELLIPAYAMAK_FROM=50004001462594
